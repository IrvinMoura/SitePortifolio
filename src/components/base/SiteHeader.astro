---
import { Image } from 'astro:assets';
import { SITE } from '../../lib/site';
import logo from '../../assets/brand/logo-im.webp';

// As cenas da home; as páginas Sobre e Registro ficam no rodapé.
const links = [
  { href: '/#projetos', label: 'Projetos', match: null },
  { href: '/#o-que-faco', label: 'O que faço', match: null },
  { href: '/#sobre', label: 'Sobre', match: null },
  { href: '/#contato', label: 'Contato', match: null },
];
const path = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="wrap site-header" id="topo">
  <a class="logo" href="/" aria-label={`IM, ${SITE.name}, início`}>
    <Image src={logo} alt="" widths={[64, 128]} sizes="3.25rem" loading="eager" />
  </a>
  <nav class="nav" aria-label="Principal">
    <ul>
      {links.map(({ href, label, match }) => (
        <li>
          <a href={href} aria-current={match && path.startsWith(match) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    padding-block: 1.25rem;
  }
  .logo {
    flex: none;
    display: block;
    width: 3.25rem;
    aspect-ratio: 1;
  }
  .logo img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
    list-style: none;
    padding: 0;
    font-size: 0.9rem;
  }
  /* Sublinhado vermelho que cresce da esquerda (INTERACTIONS I-06) */
  .nav a {
    color: var(--ink-muted);
    text-decoration: none;
    padding-bottom: 0.3em;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0% 2px no-repeat;
    transition:
      color var(--dur-instant),
      background-size var(--dur-fast) var(--ease-out);
  }
  .nav a:hover,
  .nav a:focus-visible,
  .nav a[aria-current='page'] {
    color: var(--ink);
    background-size: 100% 2px;
  }
  @media (max-width: 47.99rem) {
    .nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }
  }
</style>
