---
import { getCollection } from 'astro:content';
import ContactBlock from '../components/base/ContactBlock.astro';
import LogList from '../components/memorial/LogList.astro';
import MemorialList from '../components/memorial/MemorialList.astro';
import Section from '../components/memorial/Section.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { publishedFirst } from '../lib/content';

// Página inicial com os componentes da fase 4. Apresentação completa, Fig. 0,
// "Como trabalho" e "Sobre" chegam na fase 5.
const memoriais = publishedFirst(await getCollection('memoriais'), {
  includeDrafts: import.meta.env.DEV,
});
const registro = await getCollection('registro');
---

<BaseLayout>
  <section class="sheet wrap hero" aria-labelledby="titulo">
    <p class="label kicker">
      <span class="num">00</span> Apresentação
    </p>
    <h1 class="display wide" id="titulo">
      Construo sistemas web, automações e integrações para empresas que ainda resolvem tudo na
      planilha.
    </h1>
  </section>

  {memoriais.length > 0 && (
    <Section
      id="memoriais"
      number="01"
      label="Memoriais"
      title="Projetos documentados do problema ao resultado."
    >
      <MemorialList entries={memoriais} class="wide" />
    </Section>
  )}

  <Section
    id="registro"
    number="03"
    label="Em construção"
    title="Registro público do que está sendo feito."
  >
    <LogList entries={registro} limit={5} class="wide" />
    <p>
      <a class="link" href="/registro">
        Ver o registro completo
      </a>
    </p>
  </Section>

  <Section
    id="contato"
    number="05"
    label="Contato"
    title="Tem um processo que toma tempo demais da sua equipe? Vamos conversar."
  >
    <ContactBlock class="wide" />
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--space-section);
  }
  .hero .label {
    padding-top: 0.55rem;
  }
</style>
