---
import { SITE } from '../../lib/site';

// Linha de contato. Só mostra canais que existem de fato (sem links pendentes em produção).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['contact', className]}>
  <a class="link" href={`mailto:${SITE.email}`}>
    {SITE.email}
  </a>
  <a class="send" href={`mailto:${SITE.email}`}>
    Enviar e-mail
  </a>
  {SITE.profiles.map((p) => (
    <a class="link" href={p.href} rel="me">
      {p.label} <span aria-hidden="true">↗</span>
    </a>
  ))}
</div>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    font-size: 1.15rem;
  }
  /* abre o app de e-mail já endereçado (INTERACTIONS I-05) */
  .send {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink);
    text-decoration: none;
    border: 1px solid var(--rule-strong);
    padding: 0.4rem 0.7rem;
    transition: border-color var(--dur-instant);
  }
  .send:hover,
  .send:focus-visible {
    border-color: var(--accent);
  }
</style>
