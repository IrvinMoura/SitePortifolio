---
import { SITE } from '../../lib/site';

// Ícones de traço (desenho do Lucide, licença ISC), no cinza do site.
const ICONS: Record<string, string> = {
  Instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/>',
  GitHub:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  LinkedIn:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
};
---

<footer class="site-footer">
  <div class="wrap inner">
    <p>
      <span class="name">{SITE.name}</span>
      <span lang="ja" aria-hidden="true">
        {' '}
        · 絵巻
      </span>
      <br />
      Desenvolvedor.
    </p>
    <ul class="social" aria-label="Redes sociais">
      {SITE.profiles.map((p) => (
        <li>
          <a href={p.href} rel="me" aria-label={p.label}>
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
              set:html={ICONS[p.label]}
            />
          </a>
        </li>
      ))}
    </ul>
    <nav aria-label="Rodapé">
      <ul>
        <li>
          <a class="link" href="/privacidade">
            Política de privacidade
          </a>
        </li>
        <li>
          <a class="link" href="/termos">
            Termos de uso
          </a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="wrap">
    <a class="to-top" href="#topo" aria-label="Voltar ao topo">
      <span class="arrow" aria-hidden="true">
        ↑
      </span>
      <span class="label">Voltar ao topo</span>
    </a>
  </div>
</footer>

<script>
  // Voltar ao topo (INTERACTIONS I-18): com JS o link vira botão fixo, mostrado só no fim da página.
  const footer = document.querySelector<HTMLElement>('.site-footer');
  const button = footer?.querySelector<HTMLElement>('.to-top');
  if (footer && button) {
    new IntersectionObserver(([entry]) => {
      button.classList.toggle('shown', entry!.isIntersecting);
    }).observe(footer);
  }
</script>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem 6rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .inner {
    display: grid;
    gap: 1rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .name {
    color: var(--ink);
    font-weight: 700;
  }
  .social {
    gap: 0.75rem;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 50%;
    color: var(--ink-muted);
    transition:
      color var(--dur-instant),
      border-color var(--dur-instant);
  }
  .social a:hover,
  .social a:focus-visible {
    color: var(--ink);
    border-color: var(--accent);
  }
  /* Sem JS: link comum no fim do rodapé */
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--ink);
  }
  /* Com JS: botão redondo fixo no canto, que aparece quando o rodapé entra na tela */
  :global(.js) .to-top {
    position: fixed;
    right: var(--gutter);
    bottom: 1.5rem;
    z-index: 60;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    margin: 0;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
    background: var(--paper-2);
    color: var(--accent-ink);
    font-size: 1.25rem;
    text-decoration: none;
    box-shadow: 0 0.4rem 1.2rem rgb(0 0 0 / 0.35);
    opacity: 0;
    visibility: hidden;
    transform: translateY(1rem) scale(0.85);
    /* sai rápido; a entrada (abaixo) é mais lenta e suave */
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out),
      background-color var(--dur-instant),
      visibility 0s linear var(--dur-fast);
  }
  :global(.js) .to-top:global(.shown),
  :global(.js) .to-top:focus-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out),
      background-color var(--dur-instant),
      visibility 0s;
  }
  :global(.js) .to-top:hover {
    background: var(--accent-soft);
  }
  :global(.js) .to-top .label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
    list-style: none;
    padding: 0;
  }
</style>
