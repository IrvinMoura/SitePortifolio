---
// Pergaminho (makimono) que desenrola a foto (INTERACTIONS I-15). No desktop o rolo fechado fica
// centrado na altura do texto e abre para cima e para baixo por cima da página, sem empurrar
// nada; no celular abre no fluxo. Abre sozinho, uma vez, pouco depois de entrar na tela. Sem JS o
// rolo aparece aberto.
// Espaço reservado aprovado pelo Irvin em 21/10/2026 até existir a foto real.
---

<div class="maki-slot">
  <div class="makimono" data-open="false">
    <span class="rod" aria-hidden="true"></span>
    <div class="maki-paper" id="maki-paper">
      <div class="maki-inner">
        <div class="maki-photo" role="img" aria-label="Espaço da foto de Irvin Marques">
          <span aria-hidden="true">Sua foto aqui</span>
        </div>
      </div>
    </div>
    <span class="rod" aria-hidden="true"></span>
  </div>
</div>

<script>
  // Espera o rolo ficar bem à vista e abre depois de uma pausa, como quem desenrola com calma.
  const DELAY = 700;
  const rolls = document.querySelectorAll<HTMLElement>('.makimono');
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        setTimeout(() => ((entry.target as HTMLElement).dataset.open = 'true'), DELAY);
      }
    },
    { threshold: 0.6 },
  );
  for (const roll of rolls) observer.observe(roll);
</script>

<style>
  .maki-slot {
    justify-self: center;
    width: 16rem;
    max-width: 100%;
  }
  .makimono {
    position: relative;
    display: grid;
    width: 100%;
    margin-bottom: 3.5rem;
  }
  /* barras de madeira, como as dos rolos pendurados da cena dois */
  .rod {
    position: relative;
    z-index: 2;
    display: block;
    height: 12px;
    margin-inline: -10px;
    background: var(--ink);
    border-radius: 6px;
  }
  .rod::before,
  .rod::after {
    content: '';
    position: absolute;
    top: 1px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .rod::before {
    left: -4px;
  }
  .rod::after {
    right: -4px;
  }
  .maki-paper {
    display: grid;
    grid-template-rows: 1fr;
    background: var(--paper-2);
    transition: grid-template-rows 1.1s var(--ease-in-out);
  }
  /* fechado só quando o script existe (classe .js aplicada no <head>) */
  :global(.js) .makimono[data-open='false'] .maki-paper {
    grid-template-rows: 0fr;
  }
  .maki-inner {
    overflow: hidden;
    min-height: 10px;
  }
  .maki-photo {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    margin: 1.2rem;
    text-align: center;
    border: 1px dashed var(--ink-muted);
    background: var(--paper);
    color: var(--ink-muted);
    font: 0.8rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  @media (min-width: 40.01rem) {
    .maki-slot {
      position: relative;
      height: 3rem;
    }
    .makimono {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      translate: 0 -50%;
      margin: 0;
      z-index: 5;
    }
  }
  @media (max-width: 40rem) {
    .maki-slot {
      margin-top: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .maki-paper {
      transition: none;
    }
  }
</style>
