---
import type { CollectionEntry } from 'astro:content';
import { STATUS_LABELS, memorialNumber } from '../../lib/content';
import NatureBadge from './NatureBadge.astro';

// Lista de memoriais. Não renderiza nada quando vazia (ADR 006).
interface Props {
  entries: CollectionEntry<'memoriais'>[];
  class?: string;
}
const { entries, class: className } = Astro.props;
---

{entries.length > 0 && (
  <ol class:list={['mlist', className]}>
    {entries.map(({ id, data }) => (
      <li>
        <a class="row" href={`/memoriais/${id}`}>
          <span class="n">{memorialNumber(data.number)}</span>
          <span class="body">
            <span class="title">{data.title}</span>
            <span class="summary">{data.summary}</span>
          </span>
          <span class="arrow" aria-hidden="true">
            →
          </span>
          <span class="meta">
            <NatureBadge nature={data.nature} />
            <span>{STATUS_LABELS[data.status]}</span>
            <span>{data.stack.join(' · ')}</span>
          </span>
        </a>
      </li>
    ))}
  </ol>
)}

<style>
  .mlist {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    gap: 0.5rem 2rem;
    padding: 1.4rem 0.25rem;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background-color var(--dur-fast);
  }
  .row:hover {
    background: var(--paper-2);
  }
  .n {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
    padding-top: 0.45rem;
  }
  .title {
    display: block;
    font-family: var(--font-brush);
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .summary {
    display: block;
    color: var(--ink-muted);
    margin-top: 0.35rem;
    max-width: 38rem;
  }
  .arrow {
    grid-column: 3;
    grid-row: 1;
    font-size: var(--step-1);
    padding-top: 0.25rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .row:hover .arrow {
    transform: translateX(4px);
  }
  .meta {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.2rem;
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
    margin-top: 0.4rem;
  }
  @media (max-width: 35rem) {
    .row {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      gap: 0.5rem 1rem;
    }
    .arrow {
      display: none;
    }
  }
</style>
