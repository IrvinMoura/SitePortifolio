---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import SpecSheet, { type SpecItem } from '../../components/memorial/SpecSheet.astro';
import Toc from '../../components/memorial/Toc.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { NATURE_LABELS, STATUS_LABELS, memorialNumber, publishedFirst } from '../../lib/content';
import { formatPeriod } from '../../lib/format';

export const getStaticPaths = (async () => {
  const entries = publishedFirst(await getCollection('memoriais'), {
    includeDrafts: import.meta.env.DEV,
  });
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const number = memorialNumber(d.number);

const spec: SpecItem[] = [
  { label: 'Natureza', value: NATURE_LABELS[d.nature] },
  { label: 'Status', value: STATUS_LABELS[d.status] },
  { label: 'Papel', value: d.role },
  { label: 'Período', value: formatPeriod(d.period.start, d.period.end) },
  { label: 'Stack', value: d.stack.join(', ') },
  ...(d.links.repo ? [{ label: 'Repositório', value: 'Ver código', href: d.links.repo }] : []),
  ...(d.links.demo ? [{ label: 'Demonstração', value: 'Abrir', href: d.links.demo }] : []),
];
---

<BaseLayout title={`Memorial ${number} — ${d.title}`} description={d.summary}>
  <article>
    <header class="sheet wrap head">
      <p class="label kicker">
        <span class="num">{number}</span> Memorial
      </p>
      <h1 class="display wide">{d.title}</h1>
      <p class="lede">{d.summary}</p>
      <SpecSheet items={spec} class="wide" />
    </header>

    <div class="mem-shell wrap">
      <Toc headings={headings} />
      <div class="mem">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .head {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) 3rem;
  }
  .head .label {
    padding-top: 0.55rem;
  }
</style>
