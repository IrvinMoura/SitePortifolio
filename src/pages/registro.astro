---
import { getCollection } from 'astro:content';
import LogList from '../components/memorial/LogList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = await getCollection('registro');
---

<BaseLayout title="Registro" description="Registro público do que está sendo feito, com datas.">
  <section class="sheet wrap page" aria-labelledby="titulo">
    <p class="label kicker">
      <span class="num">03</span> Em construção
    </p>
    <h1 class="display brush wide" id="titulo">
      Registro
    </h1>
    <p class="lede">
      Prefiro mostrar o trabalho acontecendo a esperar que tudo esteja pronto. Cada entrada é
      datada.
    </p>
    <LogList entries={entries} class="wide" />
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--space-section);
  }
  .page .label {
    padding-top: 0.55rem;
  }
</style>
