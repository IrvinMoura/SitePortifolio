---
import { SITE } from '../../lib/site';
---

<footer class="site-footer">
  <div class="wrap inner">
    <p>
      <span class="name">{SITE.name}</span>
      <br />
      Desenvolvedor independente.
    </p>
    <!-- prettier-ignore -->
    <p>Site estático feito com Astro e TypeScript. Como ele foi pensado está no <a class="link" href="/memoriais/este-site">Memorial 001</a>.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--ink);
    padding-block: 2.5rem 4rem;
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .inner {
    display: grid;
    gap: 1rem 3rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .name {
    color: var(--ink);
    font-weight: 500;
  }
</style>
