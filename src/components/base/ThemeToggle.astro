---
// INTERACTIONS I-07: papel noite (padrão) ↔ washi. O tema salvo é aplicado antes da pintura por
// ThemeInit.astro.
---

<button class="theme-toggle" type="button" aria-pressed="false" data-theme-toggle>
  <span class="sr-only">Papel claro:</span> Washi
</button>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  const isLight = () => root.dataset.theme === 'light';

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => button.setAttribute('aria-pressed', String(isLight()));
    sync();
    button.addEventListener('click', () => {
      const next = isLight() ? 'dark' : 'light';
      const apply = () => {
        root.dataset.theme = next;
        sync();
      };
      if (document.startViewTransition && !reduced.matches) document.startViewTransition(apply);
      else apply();
      try {
        localStorage.setItem(KEY, next);
      } catch {
        // Sem armazenamento: o tema vale só para esta visita.
      }
    });
  }
</script>

<style>
  .theme-toggle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: none;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    padding: 0.35rem 0.6rem;
    cursor: pointer;
    transition: border-color var(--dur-instant);
  }
  .theme-toggle:hover {
    border-color: var(--ink);
  }
  .theme-toggle[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
