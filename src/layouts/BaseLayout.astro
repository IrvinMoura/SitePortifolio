---
import { Font } from 'astro:assets';
import '../styles/base.css';
import '../styles/tokens.css';
import '../styles/layout.css';
import '../styles/typography.css';
import BrushCursor from '../components/base/BrushCursor.astro';
import InkScript from '../components/base/InkScript.astro';
import IntroLoader from '../components/base/IntroLoader.astro';
import SiteFooter from '../components/base/SiteFooter.astro';
import SmokeBackground from '../components/base/SmokeBackground.astro';
import SiteHeader from '../components/base/SiteHeader.astro';
import SkipLink from '../components/base/SkipLink.astro';
import { SITE } from '../lib/site';
import { canonicalPath } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(canonicalPath(Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marca que o JS roda, antes da pintura: o pergaminho só começa fechado quando dá para abrir. -->
    <!-- Abertura com o logo (INTERACTIONS I-21): só na primeira página da visita, sem movimento reduzido. -->
    <script is:inline>
      document.documentElement.classList.add('js');
      try {
        if (
          !sessionStorage.getItem('im-intro') &&
          !matchMedia('(prefers-reduced-motion: reduce)').matches
        ) {
          document.documentElement.classList.add('intro');
          sessionStorage.setItem('im-intro', '1');
        }
      } catch {
        // sem sessionStorage (modo privado restrito): segue sem abertura
      }
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <slot name="head" />

    <Font cssVariable="--font-brush" preload />
    <Font cssVariable="--font-jp" />
    <Font cssVariable="--font-sans" preload={[{ weight: 400 }]} />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <SkipLink />
    <IntroLoader />
    <SmokeBackground />
    <BrushCursor />
    <InkScript />
    <SiteHeader />
    <main id="conteudo">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
