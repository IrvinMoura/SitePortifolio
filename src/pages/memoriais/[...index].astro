---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import MemorialList from '../../components/memorial/MemorialList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedFirst, shouldBuildIndex } from '../../lib/content';

// /memoriais só é gerada com 3 ou mais memoriais publicados (ADR 006).
// Rota "rest" para poder não gerar página nenhuma: getStaticPaths vazio = sem /memoriais.
export const getStaticPaths = (async () => {
  const entries = publishedFirst(await getCollection('memoriais'));
  return shouldBuildIndex(entries.length)
    ? [{ params: { index: undefined }, props: { entries } }]
    : [];
}) satisfies GetStaticPaths;

const { entries } = Astro.props;
---

<BaseLayout title="Memoriais" description="Projetos documentados do problema ao resultado.">
  <section class="sheet wrap page" aria-labelledby="titulo">
    <p class="label kicker">
      <span class="num">01</span> Memoriais
    </p>
    <h1 class="display wide" id="titulo">
      Memoriais
    </h1>
    <MemorialList entries={entries} class="wide" />
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--space-section);
  }
</style>
