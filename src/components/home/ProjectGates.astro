---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { STATUS_LABELS, memorialNumber } from '../../lib/content';
import NatureBadge from '../memorial/NatureBadge.astro';
import ToriiGate from './ToriiGate.astro';
import esteSite from '../../assets/memoriais/este-site.png';
import esteSiteMobile from '../../assets/memoriais/este-site-mobile.png';

// Cada projeto atrás de um portão torii, com a captura de tela na abertura (DESIGN.md). O portão
// leva direto ao site do projeto (ADR 009); projeto sem site no ar aparece sem link.
// Não renderiza nada quando vazio (ADR 006). Projeto sem captura mostra só o papel.
interface Props {
  entries: CollectionEntry<'memoriais'>[];
}
const { entries } = Astro.props;

const THUMBS: Record<string, { wide: ImageMetadata; tall: ImageMetadata; alt: string }> = {
  'este-site': {
    wide: esteSite,
    tall: esteSiteMobile,
    alt: 'Captura da página inicial deste site, com o nome Irvin Marques pintado a pincel.',
  },
};

const srcset = async (src: ImageMetadata, widths: number[]) => {
  const images = await Promise.all(widths.map((width) => getImage({ src, width, format: 'webp' })));
  return {
    src: images[0]!.src,
    srcset: images.map((img, i) => `${img.src} ${widths[i]}w`).join(', '),
  };
};

const cards = await Promise.all(
  entries.map(async ({ id, data }) => {
    const thumb = THUMBS[id];
    return {
      data,
      number: memorialNumber(data.number),
      thumb: thumb && {
        alt: thumb.alt,
        wide: await srcset(thumb.wide, [480, 960]),
        tall: await srcset(thumb.tall, [360, 720]),
      },
    };
  }),
);
---

{cards.length > 0 && (
  <ul class="works">
    {cards.map(({ data, number, thumb }) => {
      const Card = data.links.demo ? 'a' : 'div';
      return (
        <li>
          <Card
            class="work"
            {...(data.links.demo ? { href: data.links.demo, 'data-gate': '' } : {})}
          >
            <span class="torii">
              <span class="torii-view">
                {thumb && (
                  <picture>
                    <source
                      media="(max-width: 47.99rem)"
                      srcset={thumb.tall.srcset}
                      sizes="11rem"
                      width="1170"
                      height="1992"
                    />
                    <img
                      src={thumb.wide.src}
                      srcset={thumb.wide.srcset}
                      sizes="(min-width: 48rem) 15rem, 11rem"
                      width="1280"
                      height="800"
                      decoding="async"
                      alt={thumb.alt}
                    />
                  </picture>
                )}
              </span>
              <ToriiGate number={number} />
            </span>
            <span class="work-meta">
              <span class="n">{number}</span>
              <h3 class="brush">{data.title}</h3>
              <span class="sum">{data.summary}</span>
              <span class="tags">
                <NatureBadge nature={data.nature} />
                <span class="kicker">{STATUS_LABELS[data.status]}</span>
                <span class="kicker">{data.stack.join(' · ')}</span>
              </span>
              {data.links.demo && (
                <span class="go">
                  Abrir o site <span aria-hidden="true">↗</span>
                </span>
              )}
            </span>
          </Card>
        </li>
      );
    })}
  </ul>
)}

<script>
  // Travessia do portão (INTERACTIONS I-13): o torii cresce e some, a captura atrás dele ocupa a
  // tela e então o site do projeto abre. Sem JS, com movimento reduzido ou com Ctrl/⌘/Shift,
  // o link funciona normalmente.
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const EASE = 'cubic-bezier(.65, 0, .25, 1)';
  const DURATION = 700;
  const layers: HTMLElement[] = [];

  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-gate]')) {
    link.addEventListener('click', (event) => {
      if (reduced.matches || event.button !== 0) return;
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const view = link.querySelector<HTMLElement>('.torii-view');
      const torii = link.querySelector<HTMLElement>('.torii');
      const gate = [...link.querySelectorAll<SVGElement>('.torii-gate')].find(
        (svg) => getComputedStyle(svg).display !== 'none',
      );
      if (!view || !torii || !gate || !('animate' in view)) return;
      event.preventDefault();

      const r = view.getBoundingClientRect();
      const g = torii.getBoundingClientRect();
      const start = {
        left: `${r.left}px`,
        top: `${r.top}px`,
        width: `${r.width}px`,
        height: `${r.height}px`,
      };
      const full = {
        left: '0px',
        top: '0px',
        width: `${innerWidth}px`,
        height: `${innerHeight}px`,
      };

      const layer = document.createElement('div');
      layer.className = 'crossing-layer';
      Object.assign(layer.style, start);
      const img = view.querySelector('img');
      if (img) {
        const copy = document.createElement('img');
        copy.alt = '';
        copy.src = img.currentSrc || img.src;
        layer.append(copy);
      }

      const gateBox = document.createElement('div');
      gateBox.className = 'crossing-gate';
      Object.assign(gateBox.style, {
        left: `${g.left}px`,
        top: `${g.top}px`,
        width: `${g.width}px`,
        height: `${g.height}px`,
      });
      const gateCopy = gate.cloneNode(true) as SVGElement;
      gateCopy.style.transformOrigin = gate.classList.contains('gate-tall') ? '50% 62%' : '50% 67%';
      gateBox.append(gateCopy);
      document.body.append(layer, gateBox);
      layers.push(layer, gateBox);

      gateCopy.animate(
        [
          { transform: 'scale(1)', opacity: 1 },
          { transform: 'scale(5)', opacity: 0 },
        ],
        {
          duration: DURATION * 0.9,
          easing: EASE,
          fill: 'forwards',
        },
      );
      layer
        .animate([start, full], { duration: DURATION, easing: EASE, fill: 'forwards' })
        .finished.then(() => location.assign(link.href));
    });
  }

  // Voltar pelo histórico (bfcache) devolve a página como estava: tira a camada da travessia.
  addEventListener('pageshow', (event) => {
    if (event.persisted) layers.splice(0).forEach((el) => el.remove());
  });
</script>

<style>
  .works {
    display: grid;
    gap: 3rem 2.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 28rem));
    list-style: none;
    padding: 0;
  }
  .work {
    display: grid;
    gap: 1.2rem;
    text-decoration: none;
  }
  .torii {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
  }
  /* abertura do portão: entre os pilares e abaixo do nuki (coordenadas do viewBox 400x300) */
  .torii-view {
    position: absolute;
    left: 23.5%;
    width: 52%;
    top: 37%;
    height: 60%;
    overflow: hidden;
    background: var(--paper-2);
  }
  /* Sem loading="lazy" nem display: contents no <picture>: dentro da abertura com overflow
     hidden, alguns navegadores não carregavam a imagem e mostravam só o texto alternativo. */
  .torii-view picture {
    display: block;
    width: 100%;
    height: 100%;
  }
  .torii-view img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transform-origin: 50% 40%;
    filter: brightness(0.88);
    transition:
      transform 0.9s cubic-bezier(0.3, 1.4, 0.45, 1),
      filter 0.4s;
  }
  .work:hover .torii-view img,
  .work:focus-visible .torii-view img {
    transform: scale(1.06);
    filter: brightness(1);
  }
  /* celular: portão alto, com a captura do celular em pé (coordenadas do viewBox 300x420) */
  @media (max-width: 47.99rem) {
    .torii {
      aspect-ratio: 300 / 420;
      max-width: 22rem;
    }
    .torii-view {
      left: 26.7%;
      width: 46.7%;
      top: 26.2%;
      height: 71.9%;
    }
  }
  .work-meta {
    display: grid;
    gap: 0.3rem;
    padding-inline: 0.2rem;
  }
  .n {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--accent-ink);
  }
  h3 {
    font-size: clamp(1.7rem, 1.4rem + 1vw, 2.3rem);
    line-height: 1.1;
    color: var(--ink);
  }
  .sum {
    color: var(--ink-muted);
  }
  .go {
    margin-top: 0.6rem;
    font-weight: 700;
    color: var(--accent-ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin-top: 0.4rem;
  }
  :global(.crossing-layer) {
    position: fixed;
    z-index: 70;
    overflow: hidden;
    background: var(--paper);
  }
  :global(.crossing-layer img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  :global(.crossing-gate) {
    position: fixed;
    z-index: 71;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .torii-view img {
      transition: none;
    }
  }
</style>
