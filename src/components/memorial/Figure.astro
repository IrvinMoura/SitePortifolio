---
// Figura numerada com legenda. O conteúdo (tabela, imagem, diagrama ou ilha interativa)
// vem pelo slot; ilhas devem renderizar um estado estático legível sem JS.
interface Props {
  number: string;
  caption: string;
}
const { number, caption } = Astro.props;
---

<figure class="figure wide">
  <div class="figure-body">
    <slot />
  </div>
  <figcaption class="cap">
    <b>Fig. {number}</b> — {caption}
  </figcaption>
</figure>

<style>
  .figure-body {
    overflow-x: auto;
  }
  .cap {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--ink-muted);
    margin-top: 0.85rem;
    max-width: 46rem;
  }
  .cap b {
    font-weight: 500;
    color: var(--ink);
  }
  .figure-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }
  .figure-body :global(th) {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    text-align: left;
    border-bottom: 1px solid var(--ink);
    padding: 0 1rem 0.5rem 0;
  }
  .figure-body :global(td) {
    border-bottom: 1px solid var(--rule);
    padding: 0.75rem 1rem 0.75rem 0;
    vertical-align: top;
  }
</style>
