---
import Button from '../components/base/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página não encontrada" noindex>
  <section class="sheet wrap page" aria-labelledby="titulo">
    <p class="label kicker">
      <span class="num">404</span> Não encontrada
    </p>
    <h1 class="display brush wide" id="titulo">
      Esta página não existe.
    </h1>
    <p class="lede">O endereço pode ter mudado.</p>
    <p>
      <Button href="/" arrow>
        Voltar ao início
      </Button>
    </p>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--space-section);
  }
  .page .label {
    padding-top: 0.55rem;
  }
</style>
