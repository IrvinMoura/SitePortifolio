---
// Pergaminho (makimono) que desenrola a foto (INTERACTIONS I-15). No desktop o rolo fechado fica
// centrado na altura do texto e abre para cima e para baixo por cima da página, sem empurrar
// nada; no celular abre no fluxo. Sem JS o rolo aparece aberto e o botão some.
// Espaço reservado aprovado pelo Irvin em 21/10/2026 até existir a foto real.
---

<div class="maki-slot">
  <div class="makimono" data-open="false">
    <button
      class="maki-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="maki-paper"
      data-maki-toggle
    >
      <span class="maki-label">Clique aqui</span>
    </button>
    <span class="rod" aria-hidden="true"></span>
    <div class="maki-paper" id="maki-paper">
      <div class="maki-inner">
        <div class="maki-photo" role="img" aria-label="Espaço da foto de Irvin Marques">
          <span aria-hidden="true">Sua foto aqui</span>
        </div>
      </div>
    </div>
    <span class="rod" aria-hidden="true"></span>
  </div>
</div>

<script>
  for (const toggle of document.querySelectorAll<HTMLButtonElement>('[data-maki-toggle]')) {
    const maki = toggle.closest<HTMLElement>('.makimono');
    const label = toggle.querySelector('.maki-label');
    toggle.addEventListener('click', () => {
      if (!maki || !label) return;
      const open = maki.dataset.open !== 'true';
      maki.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Enrolar' : 'Clique aqui';
    });
  }
</script>

<style>
  .maki-slot {
    justify-self: center;
    width: 16rem;
    max-width: 100%;
  }
  .makimono {
    position: relative;
    display: grid;
    width: 100%;
    margin-bottom: 3.5rem;
  }
  /* barras de madeira, como as dos rolos pendurados da cena dois */
  .rod {
    position: relative;
    z-index: 2;
    display: block;
    height: 12px;
    margin-inline: -10px;
    background: var(--ink);
    border-radius: 6px;
  }
  .rod::before,
  .rod::after {
    content: '';
    position: absolute;
    top: 1px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .rod::before {
    left: -4px;
  }
  .rod::after {
    right: -4px;
  }
  .maki-paper {
    display: grid;
    grid-template-rows: 1fr;
    background: var(--paper-2);
    transition: grid-template-rows 1.1s var(--ease-in-out);
  }
  /* fechado só quando o script existe (classe .js aplicada no <head>) */
  :global(.js) .makimono[data-open='false'] .maki-paper {
    grid-template-rows: 0fr;
  }
  .maki-inner {
    overflow: hidden;
    min-height: 10px;
  }
  .maki-photo {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    margin: 1.2rem;
    text-align: center;
    border: 1px dashed var(--ink-muted);
    background: var(--paper);
    color: var(--ink-muted);
    font: 0.8rem var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .maki-toggle {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 3;
    place-items: center;
    padding: 0;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
  }
  :global(.js) .maki-toggle {
    display: grid;
  }
  .maki-label {
    padding: 0.2rem 0.9rem 0.3rem;
    font-family: var(--font-brush);
    font-size: 1.35rem;
    background: var(--accent-fill);
    color: var(--seal-text);
    transform: rotate(-3deg);
    box-shadow: 0 6px 16px -8px #000a;
    transition: transform 0.5s cubic-bezier(0.3, 1.6, 0.45, 1);
  }
  .maki-toggle:hover .maki-label {
    transform: rotate(2deg) scale(1.05);
  }
  /* aberto: o botão desce para baixo do rolo e vira "Enrolar" discreto */
  .makimono[data-open='true'] .maki-toggle {
    inset: auto auto -3.2rem 50%;
    translate: -50% 0;
  }
  .makimono[data-open='true'] .maki-label {
    padding: 0.35rem 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: none;
    color: var(--ink-muted);
    border: 1px solid var(--rule-strong);
    box-shadow: none;
    transform: none;
  }
  @media (min-width: 40.01rem) {
    .maki-slot {
      position: relative;
      height: 3rem;
    }
    .makimono {
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      translate: 0 -50%;
      margin: 0;
      z-index: 5;
    }
  }
  @media (max-width: 40rem) {
    .maki-slot {
      margin-top: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .maki-paper,
    .maki-label {
      transition: none;
    }
  }
</style>
