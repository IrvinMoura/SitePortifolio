---
import { SITE } from '../../lib/site';

// Linha de contato. Só mostra canais que existem de fato (sem links pendentes em produção).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div class:list={['contact', className]}>
  <a class="link" href={`mailto:${SITE.email}`}>
    {SITE.email}
  </a>
  <button class="copy" type="button" data-copy={SITE.email}>
    Copiar e-mail
  </button>
  <span class="status" aria-live="polite" data-copy-status></span>
  {SITE.profiles.map((p) => (
    <a class="link" href={p.href} rel="me">
      {p.label} <span aria-hidden="true">↗</span>
    </a>
  ))}
</div>

<script>
  // INTERACTIONS I-05: copia e confirma por 2 s; sem JS, o link mailto continua funcionando.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const status = button.parentElement?.querySelector('[data-copy-status]');
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        if (status) status.textContent = 'Copiado';
      } catch {
        if (status) status.textContent = 'Não foi possível copiar';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    font-size: 1.15rem;
  }
  .copy {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: none;
    color: var(--ink);
    border: 1px solid var(--rule-strong);
    padding: 0.4rem 0.7rem;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--ink);
  }
  .status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-ink);
  }
</style>
