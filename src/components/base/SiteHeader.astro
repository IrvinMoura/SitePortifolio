---
import { SITE } from '../../lib/site';
import ThemeToggle from './ThemeToggle.astro';

// As cenas da home; páginas internas (sobre, registro, memoriais) ficam no rodapé.
const links = [
  { href: '/#projetos', label: 'Projetos', match: '/memoriais' },
  { href: '/#o-que-faco', label: 'O que faço', match: null },
  { href: '/#sobre', label: 'Sobre', match: null },
  { href: '/#contato', label: 'Contato', match: null },
];
const path = Astro.url.pathname.replace(/\.html$/, '');
---

<header class="wrap site-header">
  <a class="seal" href="/" aria-label={`IM, ${SITE.name}, início`}>
    IM
  </a>
  <span class="name" aria-hidden="true">
    {SITE.name}
  </span>
  <nav class="nav" aria-label="Principal">
    <ul>
      {links.map(({ href, label, match }) => (
        <li>
          <a href={href} aria-current={match && path.startsWith(match) ? 'page' : undefined}>
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    padding-block: 1.25rem;
  }
  .seal {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    background: var(--accent-fill);
    color: var(--seal-text);
    font: 1.05rem/1 var(--font-brush);
    text-decoration: none;
    border-radius: 3px;
    transform: rotate(-4deg);
    box-shadow:
      inset 0 0 0 2px var(--accent-fill),
      inset 0 0 0 4px var(--seal-text);
  }
  .name {
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.3rem;
    list-style: none;
    padding: 0;
    font-size: 0.9rem;
  }
  .nav a {
    color: var(--ink-muted);
    text-decoration: none;
    transition: color var(--dur-instant);
  }
  .nav a:hover,
  .nav a[aria-current='page'] {
    color: var(--ink);
  }
  .nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }
  @media (max-width: 47.99rem) {
    .nav {
      order: 3;
      width: 100%;
      margin-left: 0;
    }
    .site-header :global(.theme-toggle) {
      margin-left: auto;
    }
  }
</style>
