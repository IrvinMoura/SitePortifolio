---
// Cena do rolo (場面): número em kanji e título pintado a pincel. O kanji é ornamento; o título
// já diz a cena para quem não lê japonês.
interface Props {
  id: string;
  kanji: string;
  title: string;
  /** Primeira cena, logo abaixo da abertura: sem fio em cima e mais perto do hero. */
  first?: boolean;
}
const { id, kanji, title, first = false } = Astro.props;
---

<section
  class:list={['wrap scene', { first }]}
  id={id}
  aria-labelledby={`h-${id}`}
  data-scene={kanji}
>
  <div class="scene-head">
    <span class="scene-num" lang="ja" aria-hidden="true">
      {kanji}
    </span>
    <h2 class="brush" id={`h-${id}`}>
      {title}
    </h2>
  </div>
  <slot />
</section>

<style>
  .scene {
    position: relative;
    padding-block: var(--space-section);
    border-top: 1px solid var(--rule);
  }
  .first {
    border-top: 0;
    padding-top: 1rem;
  }
  .scene-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1.5rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }
  .scene-num {
    font: 400 var(--step-scene) / 1 var(--font-jp);
    color: var(--accent-ink);
  }
  h2 {
    font-size: var(--step-3);
    line-height: 1.08;
    max-width: 18ch;
  }
</style>
